// RUN: not %dxc -T lib_6_6 -E main -fcgl -spirv -fspv-target-env=universal1.5 %S/pervertex.lib.export-stage-order.hlsl 2>&1 | FileCheck %s --check-prefix=VALIDATION
// RUN: %dxc -T lib_6_6 -E main -fcgl -spirv -Vd -fspv-target-env=universal1.5 %S/pervertex.lib.export-stage-order.hlsl | FileCheck %s --check-prefix=IR

// The compiler currently emits an invalid access chain for the pixel entry
// when the trailing export leaves SpirvContext in Library mode. Verify both
// the real validator failure and the unvalidated module. -Vd is used solely
// to inspect the invalid generated IR, not to change production behavior.
// VALIDATION: fatal error: generated SPIR-V is invalid: OpAccessChain result type
// VALIDATION: OpAccessChain %_ptr_Function_v4float %input %uint_1
// IR: OpEntryPoint Fragment
// IR: OpDecorate [[EXPORT:%[a-zA-Z0-9_]+]] LinkageAttributes "unrelated" Export
// IR-NOT: PerVertexKHR
// IR: OpAccessChain %_ptr_Function_v4float %input %uint_1
